{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@game-core": ["./packages/game-core/src"],
      "@game-core/*": ["./packages/game-core/src/*"],
      "@providers": ["./packages/providers/src"],
      "@providers/*": ["./packages/providers/src/*"],
      "@ai-orchestration": ["./packages/ai-orchestration/src"],
      "@ai-orchestration/*": ["./packages/ai-orchestration/src/*"],
      "@audio-client": ["./packages/audio-client/src"],
      "@audio-client/*": ["./packages/audio-client/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
