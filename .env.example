# Radio Night — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
#
# All secrets are server-side only. None of these values should appear
# in client-side JavaScript bundles.

# -----------------------------------------------------------------------
# Database (Neon PostgreSQL — required)
# Get your connection string from https://console.neon.tech
# Use the "pooled connection" string for serverless/edge functions.
# -----------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------
# Guest session security (required)
# Generate with: openssl rand -base64 32
# Minimum 32 bytes of entropy.
# -----------------------------------------------------------------------
GUEST_TOKEN_SECRET=replace-with-a-secure-random-string-minimum-32-bytes

# -----------------------------------------------------------------------
# Voice providers (all optional — app uses mocks if not set)
# Set USE_REAL_PROVIDERS=true to enable real API calls.
# -----------------------------------------------------------------------
USE_REAL_PROVIDERS=false

# ElevenLabs — voices for Edna, Dennis and the narrator; SFX and music generation
# A restricted key needs: Text to speech, Voices read, Sound generation, Music (User read is optional)
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Cartesia — voices for Dwight and Carol (a character whose provider has no key is captions-only)
# https://play.cartesia.ai/
CARTESIA_API_KEY=

# Fish Audio — TTS
# https://fish.audio/
FISH_AUDIO_API_KEY=

# Deepgram — STT and TTS (one key covers both)
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# -----------------------------------------------------------------------
# LLM providers (optional — app uses mock dialogue if not set)
# -----------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which LLM plays the characters: anthropic | mock (default: mock)
LLM_PROVIDER=mock
# Model for character dialogue. Haiku is fastest; Sonnet is a step up in acting.
ANTHROPIC_MODEL=claude-haiku-5-5

# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to true to enable verbose logging of pipeline timings
DEBUG_PIPELINE=false

# Hard kill switch — set to true to disable all AI provider calls
# (serves captions-only fallback mode for cost emergencies)
DISABLE_AI_PROVIDERS=false

# Daily cap on characters sent for voice synthesis (cost guard; cached lines are free).
# 0 turns voice off. Default 100000.
TTS_DAILY_CHAR_BUDGET=100000

# Request rate limits, enforced on the server. Defaults shown; all optional.
# RATE_CREATE_RUN_PER_HOUR=12   new investigations per IP
# RATE_TURNS_PER_MIN=30         questions and scene actions per guest token
# RATE_TURNS_PER_MIN_IP=90      questions and scene actions per IP
# RATE_ACCUSE_PER_MIN=10        accusations per guest token
# RATE_SPEECH_PER_MIN=120       spoken-line requests per IP
# RATE_READS_PER_MIN=60         run reads per guest token
