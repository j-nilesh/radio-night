# Radio Night — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
#
# All secrets are server-side only. None of these values should appear
# in client-side JavaScript bundles.

# -----------------------------------------------------------------------
# Database (Neon PostgreSQL — required)
# Get your connection string from https://console.neon.tech
# Use the "pooled connection" string for serverless/edge functions.
# -----------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------
# Guest session security (required)
# Generate with: openssl rand -base64 32
# Minimum 32 bytes of entropy.
# -----------------------------------------------------------------------
GUEST_TOKEN_SECRET=replace-with-a-secure-random-string-minimum-32-bytes

# -----------------------------------------------------------------------
# Voice providers (all optional — app uses mocks if not set)
# Set USE_REAL_PROVIDERS=true to enable real API calls.
# -----------------------------------------------------------------------
USE_REAL_PROVIDERS=false

# ElevenLabs — TTS, SFX generation
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Cartesia — low-latency TTS
# https://play.cartesia.ai/
CARTESIA_API_KEY=

# Fish Audio — TTS
# https://fish.audio/
FISH_AUDIO_API_KEY=

# Deepgram — STT and TTS
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# -----------------------------------------------------------------------
# LLM providers (optional — app uses mock dialogue if not set)
# -----------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which LLM to use: openai | anthropic | mock (default: mock)
LLM_PROVIDER=mock

# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to true to enable verbose logging of pipeline timings
DEBUG_PIPELINE=false

# Hard kill switch — set to true to disable all AI provider calls
# (serves captions-only fallback mode for cost emergencies)
DISABLE_AI_PROVIDERS=false
